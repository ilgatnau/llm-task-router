# Overrides .env for the local development launcher only.
# Keep shared provider keys and free-tier confirmations in .env or your shell.
# When the launcher and Ollama run in the same WSL distro:
OLLAMA_API_BASE=http://127.0.0.1:11434
QUOTA_DB=.data/quota.dev.sqlite3
# Small default for CPU/WSL development; overrides old larger tags in .env.
LOCAL_CODE_MODEL=ollama_chat/llama3.2:3b
LOCAL_GENERAL_MODEL=ollama_chat/llama3.2:3b
LOCAL_REASONING_MODEL=ollama_chat/llama3.2:3b
# Optional: disable hosted inference while developing.
# LOCAL_ONLY=true
