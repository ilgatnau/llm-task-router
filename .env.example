# Online-first routing; set true to disable ALL hosted inference.
LOCAL_ONLY=false
# For Ollama in WSL set the address reachable by the LiteLLM container.
OLLAMA_API_BASE=http://ollama:11434
LOCAL_CODE_MODEL=ollama_chat/qwen2.5-coder:7b
LOCAL_GENERAL_MODEL=ollama_chat/qwen3:8b
LOCAL_REASONING_MODEL=ollama_chat/qwen3:8b

# Gemini: FREE project only (do not attach/enable paid billing).
GEMINI_API_KEY=
# Set true only after verifying your Google project is on the free tier.
GEMINI_FREE_TIER_CONFIRMED=false

# Groq: FREE plan only (do not upgrade to Developer).
GROQ_API_KEY=
# Set true only after verifying the account is on Groq's Free plan.
GROQ_FREE_TIER_CONFIRMED=false

# Optional third pool. Only verified zero-priced :free models are sent.
# Keep the account unfunded and auto top-up off.
OPENROUTER_API_KEY=
