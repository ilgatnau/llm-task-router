# Local-only is the default even when this variable is absent.
LOCAL_ONLY=true
# Bundled Docker Ollama; for WSL set a host address reachable by LiteLLM.
OLLAMA_API_BASE=http://ollama:11434
LOCAL_CODE_MODEL=ollama_chat/qwen2.5-coder:7b
LOCAL_GENERAL_MODEL=ollama_chat/qwen3:8b
LOCAL_REASONING_MODEL=ollama_chat/qwen3:8b
# Optional legacy hosted mode requires LOCAL_ONLY=false and explicit free-* selection.
OPENROUTER_API_KEY=
