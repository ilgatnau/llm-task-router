{
  "$schema": "https://opencode.ai/config.json",
  "model": "task-router/auto",
  "provider": {
    "task-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Task Router",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local-only"
      },
      "models": {
        "auto": {
          "name": "Automatic routing (Groq first; local unit tests)",
          "tool_call": true
        },
        "local-code": {
          "name": "Local coding",
          "tool_call": true
        },
        "local-general": {
          "name": "Local general",
          "tool_call": true
        },
        "local-reasoning": {
          "name": "Local architecture and reasoning",
          "tool_call": true,
          "reasoning": true,
          "variants": {
            "thinking": {
              "reasoningEffort": "low"
            },
            "direct": {
              "reasoningEffort": "none"
            }
          }
        },
        "free-code": {
          "name": "Online-first implementation",
          "tool_call": true
        },
        "free-architecture": {
          "name": "Groq-first architecture and reasoning",
          "tool_call": true
        },
        "free-cicd": {
          "name": "Online-first CI/CD",
          "tool_call": true
        },
        "free-tests": {
          "name": "Explicit online testing (routine tests default local)",
          "tool_call": true
        }
      }
    }
  },
  "small_model": "task-router/free-code"
}
